# Copy to .env and change the password before the first start.
# Use "main" for the latest CI image, or a published release tag such as 2.1.0.
DCSMANAGER_VERSION=2.1.0
DCSMANAGER_PORT=8080
DCSMANAGER_LOG_LEVEL=info
DCSMANAGER_ADMIN_USER=admin
DCSMANAGER_ADMIN_PASSWORD=change-this-password
DCSMANAGER_SECURE_COOKIES=false
TZ=Europe/Paris

# Optional: password recovery by email. Leave the host empty to disable it.
DCSMANAGER_SMTP_HOST=
DCSMANAGER_SMTP_PORT=587
DCSMANAGER_SMTP_USER=
DCSMANAGER_SMTP_PASSWORD=
DCSMANAGER_SMTP_FROM=no-reply@example.com
DCSMANAGER_PUBLIC_URL=http://localhost:8080
DCSMANAGER_PASSWORD_RESET_TTL=1800
