# Statistics plugin configuration (copy to .env and adjust).
#
# The defaults work when PostgreSQL and the manager both run on the local
# machine. In Docker, DATABASE_URL points at the "postgres" service instead.

# PostgreSQL connection string (pgx format).
DATABASE_URL=postgres://dcs:dcs@localhost:5432/stats?sslmode=disable

# Base URL of the dcsmanager REST API.
# Local plugin:   http://127.0.0.1:8080
# In a container: http://host.docker.internal:8080 (manager must listen on 0.0.0.0)
DCSMANAGER_URL=http://127.0.0.1:8080

# Where the plugin's own dashboard is served.
PLUGIN_LISTEN_ADDR=:8090

# How often the API is polled (Go duration or seconds).
SYNC_INTERVAL=5m

# Timeout for a single API call.
SYNC_TIMEOUT=10s

# Include simulated ("test") sessions. Off by default.
INCLUDE_TEST=false

# Stat scopes to snapshot: career, mission, or "career,mission".
SYNC_SCOPES=career

# Mirror events and chat incrementally (needs the manager's ?sinceId= endpoint).
MIRROR_EVENTS=true

# Rows fetched per incremental request.
MIRROR_BATCH=1000

# Identifies this manager in a shared database, so several managers can feed one
# plugin without mixing. Defaults to "local".
MANAGER_NAME=local

# When set, the plugin's API and dashboard require this token (Bearer header or
# ?token=). Leave empty on 127.0.0.1; set it if the plugin is exposed.
PLUGIN_AUTH_TOKEN=
