# Statistics plugin configuration.
#
# PostgreSQL is the shared library: the plugin reads the manager's own tables.
# The manager must run with DCSMANAGER_DB_DRIVER=postgres for this to have data.

# The manager's PostgreSQL DSN, opened READ-ONLY. A SELECT-only role is advised.
MANAGER_DATABASE_URL=postgres://stats_reader:change-me@localhost:5432/dcsmanager?sslmode=disable

# Where the plugin's own dashboard is served.
PLUGIN_LISTEN_ADDR=:8090

# Timeout for a single query.
QUERY_TIMEOUT=15s

# Include simulated ("test") missions. Off by default.
INCLUDE_TEST=false

# When set, the plugin's API and dashboard require this token (Bearer header or
# ?token=). Leave empty on 127.0.0.1; set it if the plugin is exposed.
PLUGIN_AUTH_TOKEN=
