# Build artifacts
/backend/dcsmanager
/backend/dcsmanager.exe
/dist/
*.exe
*.exe~

# Frontend
/frontend/node_modules/
/frontend/dist/

# Generated frontend assets embedded in Go. The `dist/.gitkeep` placeholder is
# committed so that `go build` works before the frontend has been built.
/backend/internal/api/dist/*
!/backend/internal/api/dist/.gitkeep

# Local data (SQLite database and its WAL/SHM side files).
# Scoped to the runtime data directories so it never hides source data such as
# backend/internal/aerodrome/data/*.json.
/data/
/backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Large reference map scans (air navigation charts, ~1.3 GB).
# Kept locally for the charts viewer; never committed.
# Only the explanatory README is tracked.
/maps_dcs/*
!/maps_dcs/README.md

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python bytecode (tools/)
__pycache__/
*.pyc

# Local DCS scripts (never commit personal paths)
dcs-lua/Config/dcsmanager.local.cfg
